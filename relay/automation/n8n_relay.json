{
  "name": "Relay: new Gmail emails become draft replies",
  "nodes": [
    {
      "id": "68ec08b7-27d2-50c2-b3de-776aef0ad96f",
      "name": "New Gmail email",
      "type": "n8n-nodes-base.gmailTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        300
      ],
      "parameters": {
        "pollTimes": {
          "item": [
            {
              "mode": "everyMinute"
            }
          ]
        },
        "simple": false,
        "filters": {
          "labelIds": [
            "INBOX"
          ],
          "readStatus": "unread",
          "q": "-from:me -category:promotions -category:social"
        },
        "options": {}
      }
    },
    {
      "id": "63ab6422-40aa-5008-8e43-7bf98ab25176",
      "name": "Settings",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        220,
        300
      ],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "e259db03-c9d5-587b-b49f-63258d27919b",
              "name": "relay_url",
              "type": "string",
              "value": "https://relay-PASTE-YOUR-NUMBER.us-west1.run.app"
            }
          ]
        },
        "includeOtherFields": false,
        "options": {}
      }
    },
    {
      "id": "c6bdd845-9672-5196-84b4-920a534941fa",
      "name": "Ask Relay",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $('Settings').item.json.relay_url }}/api/inbound",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ message_id: $('New Gmail email').item.json.id, thread_id: $('New Gmail email').item.json.threadId, from_addr: $('New Gmail email').item.json.from.value[0].address, from_name: $('New Gmail email').item.json.from.value[0].name || '', subject: $('New Gmail email').item.json.subject || '', body: $('New Gmail email').item.json.text || '' }) }}",
        "options": {
          "timeout": 120000
        }
      }
    },
    {
      "id": "cf9f05d1-c4d6-5e8a-a305-f7dc6c77acde",
      "name": "Has a reply?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        660,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "c2478db2-0b40-568d-bd04-43bdc4ffcae3",
              "leftValue": "={{ $json.reply }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "2694f517-3918-525f-9d7c-5110d614cfd7",
      "name": "Save as a Gmail draft",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [
        900,
        280
      ],
      "webhookId": "a80ac720-efc1-58f9-8c30-0c838c5c1c6e",
      "parameters": {
        "resource": "draft",
        "subject": "={{ $('Ask Relay').item.json.subject }}",
        "emailType": "text",
        "message": "={{ ($('Ask Relay').item.json.needs_human ? '[Relay: needs a person: ' + $('Ask Relay').item.json.reasons.join('; ') + '. Edit before sending.]\\n\\n' : '') + $('Ask Relay').item.json.reply }}",
        "options": {
          "threadId": "={{ $('Ask Relay').item.json.thread_id }}",
          "sendTo": "={{ $('Ask Relay').item.json.to }}"
        }
      }
    }
  ],
  "connections": {
    "New Gmail email": {
      "main": [
        [
          {
            "node": "Settings",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Settings": {
      "main": [
        [
          {
            "node": "Ask Relay",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Ask Relay": {
      "main": [
        [
          {
            "node": "Has a reply?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Has a reply?": {
      "main": [
        [
          {
            "node": "Save as a Gmail draft",
            "type": "main",
            "index": 0
          }
        ],
        []
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "timezone": "America/New_York"
  },
  "pinData": {},
  "active": false,
  "meta": {
    "templateCredsSetupCompleted": false
  }
}
